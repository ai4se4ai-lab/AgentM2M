{
  "name": "agentm2m",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/engine --filter=./apps/dashboard run build",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/engine run test",
    "lint": "pnpm -r run lint",
    "dev:engine": "pnpm --filter @agentm2m/engine dev",
    "dev:dashboard": "pnpm --filter @agentm2m/dashboard dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.22.0"
}
