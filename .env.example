# Engine
PORT=4000
DATA_DIR=./data
# Ollama host reachable from inside the engine container.
# On Docker Desktop (Mac/Windows): http://host.docker.internal:11434
# On Linux: host.docker.internal also works (compose maps it to the host gateway).
OLLAMA_DEFAULT_HOST=http://host.docker.internal:11434

# Dashboard
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
NEXT_PUBLIC_BENCH_URL=http://localhost:8000

# Bench service
DOCKER_HOST=unix:///var/run/docker.sock

# Host port for the bench service in docker compose (change if 8000 is already in use)
BENCH_HOST_PORT=8000

# Host port for the dashboard in docker compose (change if 3000 is already in use)
DASHBOARD_HOST_PORT=3000
